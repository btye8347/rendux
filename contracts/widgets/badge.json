{
  "name": "badge",
  "description": "Compact colored label chip; optional leading status dot.",
  "status": "verified",
  "interaction": {
    "profile": "static"
  },
  "accepts_each": true,
  "props": {
    "label": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enum",
      "enum": [
        "default",
        "info",
        "success",
        "warn",
        "error"
      ],
      "required": false
    },
    "dot": {
      "type": "bool",
      "required": false
    }
  }
}
